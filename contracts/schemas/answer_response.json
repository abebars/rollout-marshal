{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abebars/rollout-marshal/contracts/schemas/answer_response.json",
  "title": "Answer function response",
  "description": "What an answer function returns (design.md section 5). A reply that fails this schema fails the health probe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "input_tokens",
    "output_tokens",
    "model_id"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "model_id": {
      "enum": [
        "us.anthropic.claude-fable-5-1",
        "us.anthropic.claude-sonnet-5"
      ]
    }
  }
}
