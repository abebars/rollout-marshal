{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abebars/rollout-marshal/contracts/schemas/run_item.json",
  "title": "Run item",
  "description": "A run in table rm-runs, pk RUN#<run_id> (design.md section 6), as Python holds it: write it through contracts.dynamo.to_dynamo and read it back through contracts.dynamo.from_dynamo (whole numbers become int, fractions float). Every *_at value is ISO 8601 UTC in one form, written with contracts.names.utc_iso(). history[0] is the start transition, with from null. notified is written empty at create. history actor is the table's Actor column for that transition, not the payload's actor. A commit removes pending (design.md section 6, step 3); pending_at may stay behind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pk",
    "run_id",
    "state",
    "prompt",
    "plan",
    "history",
    "notified",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "pk": {
      "type": "string",
      "pattern": "^RUN#r[a-z]*[0-9]{4,12}$"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "$ref": "plan.json"
    },
    "feature_key": {
      "type": "string",
      "pattern": "^assistant_model_r[a-z]*[0-9]{4,12}$"
    },
    "experiment_id": {
      "type": "integer",
      "minimum": 0
    },
    "metric_ids": {
      "description": "Metric name to Flagsmith metric ID. The ID type is confirmed by task 1.3.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "helpful_rate",
          "mean_latency_ms",
          "mean_cost_micro_usd"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "incidents": {
      "description": "One entry per rollback, appended by every commit into ROLLED_BACK from RUNNING or RESULTS_READY; the AWAITING_RESUME -> RUNNING commit sets resumed_at on the open entry. Absent until the first rollback.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "started_at"
        ],
        "properties": {
          "started_at": {
            "$ref": "#/$defs/utc"
          },
          "resumed_at": {
            "$ref": "#/$defs/utc"
          }
        }
      }
    },
    "notified": {
      "description": "Notification dedupe key (<history length when claimed>#<to state>, contracts.names.dedupe_key) to the SNS message ID. Written empty at create; a key is recorded after its publish succeeds.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*#(PLANNED|RUNNING|ROLLED_BACK|AWAITING_RESUME|RESULTS_READY|PROMOTED|HELD|ABORTED)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "report_key": {
      "type": "string",
      "pattern": "^runs/r[a-z]*[0-9]{4,12}/report\\.md$"
    },
    "history": {
      "description": "Appended on every transition. The first entry is always the start transition, (none) to PLANNED.",
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/history_first"
        }
      ],
      "items": {
        "$ref": "#/$defs/history_later"
      }
    },
    "pending": {
      "$ref": "#/$defs/state"
    },
    "pending_at": {
      "$ref": "#/$defs/utc"
    },
    "last_refresh_at": {
      "$ref": "#/$defs/utc"
    },
    "first_running_at": {
      "$ref": "#/$defs/utc"
    },
    "created_at": {
      "$ref": "#/$defs/utc"
    },
    "updated_at": {
      "$ref": "#/$defs/utc"
    }
  },
  "dependentRequired": {
    "pending": [
      "pending_at"
    ]
  },
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^r[a-z]*[0-9]{4,12}$"
    },
    "state": {
      "enum": [
        "PLANNED",
        "RUNNING",
        "ROLLED_BACK",
        "AWAITING_RESUME",
        "RESULTS_READY",
        "PROMOTED",
        "HELD",
        "ABORTED"
      ]
    },
    "utc": {
      "description": "ISO 8601 UTC in the one stored form, e.g. 2026-11-27T15:30:05.123456Z, as contracts.names.utc_iso() writes it, so values sort as strings. Convert an alarm payload's at with utc_iso(at) before storing it.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "from",
        "to",
        "actor",
        "reason"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/utc"
        },
        "from": {
          "enum": [
            null,
            "PLANNED",
            "RUNNING",
            "ROLLED_BACK",
            "AWAITING_RESUME",
            "RESULTS_READY",
            "PROMOTED",
            "HELD",
            "ABORTED"
          ]
        },
        "to": {
          "$ref": "#/$defs/state"
        },
        "actor": {
          "enum": [
            "engineer",
            "agent"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "history_first": {
      "allOf": [
        {
          "$ref": "#/$defs/history_entry"
        }
      ],
      "properties": {
        "from": {
          "const": null
        },
        "to": {
          "const": "PLANNED"
        },
        "actor": {
          "const": "engineer"
        }
      }
    },
    "history_later": {
      "allOf": [
        {
          "$ref": "#/$defs/history_entry"
        }
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/state"
        }
      }
    }
  }
}
