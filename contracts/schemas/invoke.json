{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abebars/rollout-marshal/contracts/schemas/invoke.json",
  "title": "Agent invocation payload",
  "description": "What the marshal CLI, rm-invoker and the rm-tick schedule send to rm_agent (design.md section 7). One shape per action. actor is required, and is engineer, on the four engineer actions that change state, and absent elsewhere.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "prompt",
        "actor"
      ],
      "properties": {
        "action": {
          "const": "start"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "const": "engineer"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "run_id",
        "actor"
      ],
      "properties": {
        "action": {
          "enum": [
            "approve",
            "decline",
            "check"
          ]
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "actor": {
          "const": "engineer"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "const": "status"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "alarm_name",
        "alarm_state",
        "at"
      ],
      "properties": {
        "action": {
          "const": "alarm"
        },
        "alarm_name": {
          "const": "rm-cheaper-latency-p95"
        },
        "alarm_state": {
          "const": "ALARM"
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "const": "tick"
        }
      }
    }
  ],
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^r[a-z]*[0-9]{4,12}$"
    },
    "timestamp": {
      "description": "ISO 8601 date and time with an explicit offset: Z, +HH:MM or +HHMM. CloudWatch alarm state change events carry time as 2019-10-02T17:04:40Z and detail.state.timestamp as 2019-10-02T17:04:40.989+0000 (docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/cloudwatch-and-eventbridge.html); both are accepted.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:?[0-9]{2})$"
    }
  }
}
