# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Terraform: state lives in S3. Never commit local state, plans or variable
# files (variable files can hold values that must not be public).
.terraform/
# terraform init or test inside a module writes its own lock file; only infra/'s is kept.
infra/modules/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local secrets and settings
.env
.env.*
.claude/settings.local.json

# Lambda build output
*.zip

# AgentCore CLI project (agent/): its CDK app and npm packages
node_modules/
cdk.out/

# Agent worktrees that Claude Code creates for the workstream agents
.claude/worktrees/
