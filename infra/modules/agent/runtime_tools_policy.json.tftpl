{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:${region}:${account_id}:table/${runs_table}"
    },
    {
      "Sid": "LatencyAlarm",
      "Effect": "Allow",
      "Action": "cloudwatch:DescribeAlarms",
      "Resource": "arn:aws:cloudwatch:${region}:${account_id}:alarm:${alarm_name}"
    },
    {
      "Sid": "HealthProbe",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:${region}:${account_id}:function:${cheaper_function}"
    },
    {
      "Sid": "TickSchedule",
      "Effect": "Allow",
      "Action": [
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule"
      ],
      "Resource": "arn:aws:scheduler:${region}:${account_id}:schedule/${schedule_group}/${tick_schedule}"
    },
    {
      "Sid": "PassSchedulerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${account_id}:role/${scheduler_role}",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "${scheduler_principal}"
        }
      }
    },
    {
      "Sid": "IncidentNotes",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:${region}:${account_id}:${incidents_topic}"
    },
    {
      "Sid": "Reports",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${reports_bucket}/${reports_prefix}*"
    }
  ]
}
